{
  "version": 8,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0a0e16" }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#0f2318",
        "fill-opacity": 0.9,
        "fill-outline-color": "rgba(22, 78, 44, 0.4)"
      }
    },
    {
      "id": "landuse_hospital",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "hospital"],
      "paint": { "fill-color": "#1e0e1a", "fill-opacity": 0.9 }
    },
    {
      "id": "landuse_school",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "school"],
      "paint": { "fill-color": "#171308", "fill-opacity": 0.9 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#0b1e35" }
    },
    {
      "id": "aeroway_fill",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "minzoom": 11,
      "filter": ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
      "paint": { "fill-color": "#14161c", "fill-opacity": 0.9 }
    },
    {
      "id": "road_motorway_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all", ["==", ["get", "class"], "motorway"], ["!=", ["get", "ramp"], 1]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#1a2438",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 0.8, 7, 2.2, 20, 28]
      }
    },
    {
      "id": "road_trunk_primary_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["match", ["get", "class"], ["primary", "trunk"], true, false]],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#1c2840",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 0.6, 7, 2, 20, 26]
      }
    },
    {
      "id": "road_secondary_tertiary_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["match", ["get", "class"], ["secondary", "tertiary"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#1e2c42",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 8, 2, 20, 20]
      }
    },
    {
      "id": "road_minor_casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["match", ["get", "class"], ["minor"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#1a2235",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 12, 1, 14, 5, 20, 22]
      }
    },
    {
      "id": "road_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": ["all", ["==", ["get", "class"], "motorway"], ["!=", ["get", "ramp"], 1]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": ["interpolate", ["linear"], ["zoom"], 5, "#3a5080", 8, "#22d3ee"],
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 0, 7, 1.5, 20, 22]
      }
    },
    {
      "id": "road_trunk_primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["match", ["get", "class"], ["primary", "trunk"], true, false]],
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": "#4a6090",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 5, 0, 7, 1.2, 20, 22]
      }
    },
    {
      "id": "road_secondary_tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["match", ["get", "class"], ["secondary", "tertiary"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3a4e70",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 6.5, 0, 8, 0.8, 20, 16]
      }
    },
    {
      "id": "road_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["all", ["match", ["get", "class"], ["minor"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#2a3650",
        "line-width": ["interpolate", ["exponential", 1.2], ["zoom"], 13.5, 0, 14, 2, 20, 16]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "maxzoom": 16,
      "paint": {
        "fill-color": "#111826",
        "fill-outline-color": "rgba(34,211,238,0.1)"
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 16,
      "paint": {
        "fill-extrusion-base": ["get", "render_min_height"],
        "fill-extrusion-color": "#111826",
        "fill-extrusion-height": ["get", "render_height"],
        "fill-extrusion-opacity": 0.7
      }
    },
    {
      "id": "water_name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 12,
        "text-max-width": 5
      },
      "paint": {
        "text-color": "#3a7aaa",
        "text-halo-color": "rgba(10,14,22,0.85)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "poi_transit",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": ["match", ["get", "class"], ["airport", "bus", "rail"], true, false],
      "layout": {
        "icon-image": ["to-string", ["get", "class"]],
        "icon-size": 0.75,
        "text-anchor": "left",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-max-width": 9,
        "text-offset": [0.9, 0],
        "text-size": 11
      },
      "paint": {
        "text-color": "#0d9488",
        "text-halo-color": "rgba(10,14,22,0.9)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "highway-name-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 11,
      "filter": ["match", ["get", "class"], ["primary", "secondary", "tertiary", "trunk", "motorway"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-rotation-alignment": "map",
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 11, 16, 15]
      },
      "paint": {
        "text-color": "#c8d8f0",
        "text-halo-color": "rgba(10,14,22,0.9)",
        "text-halo-width": 1.8
      }
    },
    {
      "id": "highway-name-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": ["match", ["get", "class"], ["minor", "service", "track"], true, false],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name_en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-rotation-alignment": "map",
        "text-size": ["interpolate", ["linear"], ["zoom"], 15, 10, 18, 13]
      },
      "paint": {
        "text-color": "#8a9ab8",
        "text-halo-color": "rgba(10,14,22,0.85)",
        "text-halo-width": 1.2
      }
    }
  ]
}
